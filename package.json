{
  "name": "smartsched",
  "version": "1.0.0",
  "description": "College timetable generator and algorithm comparison system",
  "private": true,
  "scripts": {
    "prestart": "lsof -ti :3001 | xargs kill -9 2>/dev/null; true",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node server/index.js",
    "dev:client": "npm --prefix client run dev",
    "build": "npm run build:engine && npm --prefix client run build",
    "start": "NODE_ENV=production node server/index.js",
    "build:engine": "node scripts/build-engine.js",
    "test:engine": "node scripts/test-engine.js",
    "test:server": "node scripts/test-server.js",
    "benchmark": "node scripts/benchmark.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mongoose": "^8.9.5"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
